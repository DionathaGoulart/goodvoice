# Copy to `server/.env` (gitignored) to point Wrangler at a specific Cloudflare
# account without touching the machine-wide `wrangler login`.
#
# Create the token at dash.cloudflare.com > My Profile > API Tokens, using the
# "Edit Cloudflare Workers" template. The account id is on any account's
# overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
